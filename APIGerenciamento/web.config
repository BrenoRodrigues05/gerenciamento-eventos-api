<configuration>
	<system.webServer>
		<handlers>
			<remove name="aspNetCore"/>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified"/>
		</handlers>
		<aspNetCore
    processPath="dotnet"
    arguments=".\APIGerenciamento.dll"
    stdoutLogEnabled="true"
    stdoutLogFile="C:\APIGerenciamento\logs\stdout"
    hostingModel="OutOfProcess" />
	</system.webServer>
</configuration>
